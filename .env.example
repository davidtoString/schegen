# Server Configuration
PORT=3000

# Persistent application data and credential encryption
DATA_DIR=./data
# Required for stable encrypted credentials in hosted deployments.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
MAX_CRAWL_PAGES=100

# Exact browser origin; HTTPS required for cloud domains.
PUBLIC_URL=http://localhost:3000
# Optional trusted reverse-proxy IP/CIDR. Leave empty unless configured deliberately.
TRUST_PROXY=
# For compose.cloud.yaml/compose.traefik.yaml, set your real DNS hostname (no scheme/path).
APP_DOMAIN=

# Optional one-time administrator bootstrap: if set AND no administrator exists yet,
# the account is created from these on startup (password 9+ characters). Has no effect
# once an administrator is configured — leaving these set afterward does nothing further.
# To change the password later, run instead (do not edit these values to do it):
# docker compose exec schema-workspace node scripts/admin-user.js admin
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# AI API Keys (for schema generation and verification; can also be set per-provider in AI Settings)
OPENAI_API_KEY=
GEMINI_API_KEY=
