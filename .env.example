# Server Configuration
PORT=3000

# Persistent application data and credential encryption
DATA_DIR=./data
# Required for stable encrypted credentials in hosted deployments.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
MAX_CRAWL_PAGES=100

# Exact browser origin; HTTPS required for cloud domains.
PUBLIC_URL=http://localhost:3000
# Optional trusted reverse-proxy IP/CIDR. Leave empty unless configured deliberately.
TRUST_PROXY=
# For compose.cloud.yaml, set your real DNS hostname (no scheme/path).
APP_DOMAIN=
# Create/reset your administrator interactively; no password is stored in this file:
# docker compose exec schema-workspace node scripts/admin-user.js admin

# Default WordPress Settings (optional - can be set via UI)
WP_SITE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# Organization defaults for schema (can also be auto-detected from site)
DEFAULT_ORG_NAME=
DEFAULT_ORG_URL=
DEFAULT_ORG_LOGO=

# Default business type (HVACBusiness, Plumber, Electrician, RoofingContractor, etc.)
DEFAULT_BUSINESS_TYPE=HVACBusiness

# Default service areas (comma-separated)
DEFAULT_AREA_SERVED=

# Default phone number
DEFAULT_PHONE=

# AI API Keys (for verification features)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Direct Database Connection (for direct schema injection)
# Use this instead of REST API for more reliable schema insertion
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DB_TABLE_PREFIX=wp_
