    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.22.2",
    "fast-xml-parser": "^5.10.1",
    "mysql2": "^3.16.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
