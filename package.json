{
  "name": "schema-generator",
  "version": "3.0.0",
  "description": "Multi-site WordPress crawl, JSON-LD generation and verified publishing through REST metadata or an optional connector.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
