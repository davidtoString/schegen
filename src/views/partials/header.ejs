<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - WordPress Schema Generator</title>
  <link rel="stylesheet" href="/css/style.css">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <script src="/js/auth.js"></script>
</head>
<body>
  <header class="header">
    <div class="container">
      <h1 class="logo">Schema Generator</h1>
      <nav class="nav">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <form method="post" action="/logout" class="logout-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <span><%= currentUser %></span>
          <button class="btn btn-secondary" type="submit">Sign out</button>
        </form>
        <% } %>
        <div class="nav-links">
          <a href="/" data-workspace-section="sites">1 · Connect &amp; Crawl</a>
          <a href="/generator" data-workspace-section="generate">2 · AI Schema</a>
          <a href="/results" data-workspace-section="results">3 · Review &amp; Publish</a>
        </div>
        <button class="theme-toggle" id="theme-toggle" title="Toggle dark mode">
          <span class="icon">🌙</span>
          <span class="label">Dark</span>
        </button>
      </nav>
    </div>
  </header>
  <main class="main">
    <div class="container">
