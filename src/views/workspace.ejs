<%- include('partials/header') %>

<div id="workspace-alert" class="workspace-alert" role="status" hidden></div>

    <section id="empty-state" class="empty-state">
      <div class="empty-icon"><img src="/img/favicon.svg" alt=""></div>
      <h1>Add your first site</h1>
      <p>Install the Schematic Connector plugin on WordPress, then connect it here. New here? Read <a href="#" data-action="open-help">how Schematic works</a>.</p>
      <div class="summary-actions" style="justify-content:center">
        <a class="btn btn-secondary" href="/api/workspaces/connector" download>Download plugin</a>
        <button class="btn btn-primary" data-action="new-site">Connect WordPress</button>
      </div>
    </section>

    <section id="site-panel" hidden>
      <header class="page-header">
        <div><h1 id="active-site-name"></h1><a id="active-site-url" target="_blank" rel="noopener"></a></div>
        <div class="summary-actions">
          <span id="connection-badge" class="status-badge">Untested</span>
          <button class="btn btn-secondary" id="test-site">Test connection</button>
          <button class="btn btn-secondary" id="edit-site">Site settings</button>
        </div>
      </header>
      <p id="workflow-guide" class="workspace-guide" role="status">Add your site and configure AI Settings to begin.</p>

      <section class="card profile-card" id="profile-card">
        <div class="section-heading">
          <div><h3>Business profile</h3><p class="muted" id="profile-summary">Not set up yet.</p></div>
          <button class="btn btn-secondary" id="edit-profile">Edit profile</button>
        </div>
        <p id="profile-gaps" class="profile-gaps" hidden></p>
      </section>

      <nav class="wizard-steps" aria-label="Workflow steps">
        <button type="button" class="wizard-step" data-step="pages"><span class="wizard-step-number">1</span><span class="wizard-step-label">Pages</span></button>
        <button type="button" class="wizard-step" data-step="action"><span class="wizard-step-number">2</span><span class="wizard-step-label">Action</span></button>
        <button type="button" class="wizard-step" data-step="review"><span class="wizard-step-number">3</span><span class="wizard-step-label">Review</span></button>
        <button type="button" class="wizard-step" data-step="apply"><span class="wizard-step-number">4</span><span class="wizard-step-label">Apply</span></button>
      </nav>

      <section class="card step-card" data-wizard-step="pages">
        <h3>Select pages</h3>
        <p>Fetch published content from this site, then choose which pages to work with below.</p>
        <label for="page-filter">Content to include</label>
        <select id="page-filter"><option value="all">All published content</option><option value="pages">Pages only</option><option value="posts">Posts only</option></select>
        <details class="workspace-options"><summary>Choose a sitemap or specific URLs</summary>
        <label for="sitemap-url">Sitemap URL <small>(optional)</small></label>
        <input id="sitemap-url" type="url" placeholder="https://example.com/sitemap_index.xml">
        <label for="manual-urls">Specific page URLs <small>(optional, one per line)</small></label>
        <textarea id="manual-urls" rows="3" placeholder="https://example.com/about/"></textarea>
        </details>
        <div class="summary-actions" style="justify-content:flex-start"><button class="btn btn-primary" id="start-crawl">Crawl site</button><button class="btn btn-secondary" id="recrawl-failed" hidden>Retry failed pages</button></div>
        <p class="muted selection-hint"></p>
        <div class="summary-actions">
          <button class="btn btn-primary" id="pages-continue" disabled>Continue →</button>
        </div>
      </section>

      <section class="card step-card" data-wizard-step="action" hidden>
        <h3>What do you want to do?</h3>
        <p class="muted selection-hint"></p>
        <div class="action-choice">
          <button type="button" class="action-card" id="choose-create">
            <strong>Create new schema</strong>
            <span>AI generates JSON-LD for the selected pages, then you review and publish it.</span>
          </button>
          <button type="button" class="action-card" id="choose-delete">
            <strong>Delete existing schema</strong>
            <span>Remove app-published schema from the selected pages (reversible).</span>
          </button>
        </div>
        <div class="summary-actions"><button type="button" class="btn btn-secondary" id="action-back">← Back</button></div>
      </section>

      <section class="card step-card" data-wizard-step="review" hidden>
        <div id="review-create-panel">
          <h3>Generate schema</h3>
          <div class="engine-choice" role="radiogroup" aria-label="How to build the schema">
            <label class="engine-option"><input type="radio" name="engine" value="rules" checked><span><strong>Rules</strong><small>Instant and free. Built from the business profile and page rules, copied exactly from the page.</small></span></label>
            <label class="engine-option"><input type="radio" name="engine" value="ai"><span><strong>AI</strong><small>Slower, costs per page. For types the rules can't build.</small></span></label>
          </div>
          <p class="muted" id="rules-hint">Each page gets the types its kind is set to in <strong>Business profile → Page rules</strong>. Use <strong>Types</strong> on a row to change one page.</p>
          <div id="ai-fields" hidden>
            <label for="ai-provider">Provider</label><select id="ai-provider"><option value="openai">OpenAI</option><option value="gemini">Gemini</option></select>
            <p id="ai-configuration-status" class="muted"></p>
            <label for="ai-model-choice">Model</label><select id="ai-model-choice"><option value="">Loading model settings…</option></select>
            <label id="ai-model-custom" hidden>Custom model ID<input id="ai-model" placeholder="Exact model ID for this provider"></label>
            <details class="workspace-options"><summary>Use a different API key for this run</summary><label for="ai-key">API key <small>(not saved)</small></label><input id="ai-key" type="password" autocomplete="off" placeholder="Use saved key from AI Settings"></details>
          </div>
          <fieldset class="type-picker" id="ai-type-picker" hidden>
            <legend>Schema types to generate</legend>
            <p class="muted">Pick the types for the selected pages, or leave all unchecked to let the AI choose. Use <strong>Types</strong> on a row to set one page differently.</p>
            <div id="type-options" class="type-options"></div>
            <label for="type-custom">Other schema.org types <small>(optional, comma-separated)</small></label>
            <input id="type-custom" placeholder="e.g. HVACBusiness, Plumber">
            <button type="button" class="btn btn-secondary" id="apply-types">Use these types for selected pages</button>
          </fieldset>
          <button class="btn btn-primary" id="generate-run" disabled>Generate schema</button>
        </div>
        <div id="review-delete-panel" hidden>
          <h3>Confirm removal</h3>
          <p>Confirm the pages below, then preview removal. Nothing is written to WordPress until you apply on the next step.</p>
        </div>
        <div id="schema-policy-group">
          <label for="schema-policy">If a page already has schema</label>
          <select id="schema-policy">
            <option value="replace-existing">Replace it with the new schema</option>
            <option value="keep">Keep existing — skip pages that already have schema</option>
            <option value="replace-managed">Replace only the app's previous schema</option>
            <option value="remove-existing" hidden>Remove schema from this page</option>
            <option value="review">Advanced: keep Rank Math output and add app schema</option>
          </select>
          <p class="muted">Replace/remove requires Connector 1.2+. It suppresses Rank Math output on selected pages, preserving its underlying settings for Undo. Other plugins' schema is not removed.</p>
        </div>
        <p class="muted selection-hint"></p>
        <div class="summary-actions">
          <button type="button" class="btn btn-secondary" id="review-back">← Back</button>
          <button class="btn btn-secondary" id="preview-publish" disabled>Preview changes</button>
          <button class="btn btn-primary" id="review-continue" disabled>Continue to Apply →</button>
        </div>
      </section>

      <section class="card step-card" data-wizard-step="apply" hidden>
        <h3>Apply changes</h3>
        <p class="muted">Open Review on each page below to check the before/after, then approve to write to WordPress.</p>
        <label class="toggle-row"><input id="acknowledge-conflicts" type="checkbox">I reviewed the before/after and approve this action.</label>
        <p class="muted selection-hint"></p>
        <div class="summary-actions">
          <button type="button" class="btn btn-secondary" id="apply-back">← Back</button>
          <button class="btn btn-primary" id="publish-run" disabled>Apply reviewed changes</button>
          <button class="btn btn-secondary" id="verify-run" disabled>Verify live pages</button>
          <button class="btn btn-secondary" id="rollback-run" disabled>Undo last change</button>
        </div>
        <h4>Use with a header code plugin instead</h4>
        <p class="muted">Download the generated JSON-LD to paste into WPCode, Insert Headers and Footers, or a similar plugin. If you do, don't also apply it here, or the page will carry the schema twice.</p>
        <div class="summary-actions" style="justify-content:flex-start">
          <button class="btn btn-secondary" data-export="html">Download &lt;script&gt; tags</button>
          <button class="btn btn-secondary" data-export="json">Download JSON</button>
          <button class="btn btn-secondary" id="download-backups">Download all backups</button>
        </div>
      </section>

      <section class="card run-card">
        <div class="section-heading"><h3 id="run-title">No crawl yet</h3><div id="run-status" class="status-badge">Ready</div></div>
        <p id="selection-summary" class="muted" role="status"></p>
        <div id="run-summary" class="metric-row"></div>
        <p id="run-message" role="status"></p>
        <div id="pages-table" class="pages-table"><p class="muted">Discover pages to begin.</p></div>
      </section>

      <section class="card history-card">
        <div class="section-heading"><h3>Run history</h3></div>
        <div id="run-history"><p class="muted">No recorded runs.</p></div>
      </section>
    </section>

<dialog id="site-dialog" class="site-dialog">
  <form id="site-form" method="dialog" class="dialog-body">
    <div class="dialog-heading"><div><span class="eyebrow">Site registration</span><h2 id="site-dialog-title">Register a site</h2></div><button type="button" class="icon-button" id="close-dialog">×</button></div>
    <input type="hidden" id="site-id">
    <div class="form-grid">
      <label>Site name<input id="site-name" required placeholder="Acme Heating"></label>
      <label>WordPress URL<input id="site-url" type="url" required placeholder="https://example.com"></label>
    </div>
    <p>Create an Application Password under WordPress → Users → Profile. Each site has its own credentials. No database access or table prefix is needed.</p>
    <div class="form-grid">
      <label>WordPress username<input id="wp-username" autocomplete="username"></label>
      <label>Application password<input id="wp-password" type="password" autocomplete="new-password" placeholder="Leave blank to keep existing"></label>
    </div>
    <p><a href="/api/workspaces/connector" download>Download Connector 1.3 ZIP</a>. Upload or update under Plugins → Add New → Upload Plugin and activate. Required for reversible Rank Math replacement/removal.</p>
    <label>Default schema image <small>(optional)</small><input id="org-image" type="url" placeholder="https://example.com/brand-photo.jpg"></label>
    <p class="muted">Used only on pages where no suitable content photo was found on the page itself (decorative dividers, spacers and icons are automatically skipped, never chosen). Pages with their own image keep it — this never overrides a good page-specific photo.</p>
    <div class="dialog-actions"><button type="button" class="btn btn-danger dialog-delete" id="delete-site" hidden>Delete site</button><button type="button" class="btn btn-secondary" id="cancel-dialog">Cancel</button><button type="submit" class="btn btn-primary">Save site</button></div>
  </form>
</dialog>

<dialog id="schema-dialog" class="site-dialog">
  <div class="dialog-body">
    <div class="dialog-heading"><h2>Schema and crawl review</h2><button id="close-schema" class="icon-button" aria-label="Close">×</button></div>
    <p id="schema-review-url"></p>
    <pre id="schema-review-messages" style="white-space:pre-wrap"></pre>
    <h3>Generated JSON-LD</h3>
    <div class="summary-actions" style="justify-content:flex-start"><button type="button" class="btn btn-secondary" id="copy-script">Copy &lt;script&gt; tag</button><button type="button" class="btn btn-secondary" id="copy-json">Copy JSON</button></div>
    <pre id="schema-review-json" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre>
      <h3>Existing JSON-LD</h3><pre id="schema-review-existing" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre>
      <h3>Publish preview</h3><pre id="schema-review-decision" style="white-space:pre-wrap"></pre>
      <div class="schema-comparison"><section><h3>Stored value before</h3><pre id="schema-review-before"></pre></section><section><h3>Proposed app schema</h3><pre id="schema-review-after"></pre></section></div>
      <details><summary>Insertion and rollback records</summary><pre id="schema-review-records" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre></details>
    <h3>Crawled content</h3><pre id="schema-review-content" style="white-space:pre-wrap"></pre>
  </div>
</dialog>

<dialog id="profile-dialog" class="site-dialog">
  <form id="profile-form" class="dialog-body">
    <div class="dialog-heading"><div><span class="eyebrow">Used on every page</span><h2>Business profile</h2></div><button type="button" class="icon-button" id="close-profile" aria-label="Close">×</button></div>
    <p>Enter the business details once; every page links to them. <strong>Detect from site</strong> fills this in from the site's existing schema, homepage and page titles. Check it before saving.</p>
    <div class="summary-actions" style="margin-top:.5rem"><button type="button" class="btn btn-secondary" id="detect-profile">Detect from site</button><span class="muted" id="profile-message" role="status"></span></div>
    <div class="form-grid">
      <label>Business name<input id="pf-name" required></label>
      <label>Business type<input id="pf-type" list="business-types" placeholder="HVACBusiness"><datalist id="business-types"></datalist></label>
      <label>Phone<input id="pf-telephone"></label>
      <label>Email<input id="pf-email" type="email"></label>
      <label>Logo URL<input id="pf-logo" type="url"></label>
      <label>Photo URL <small>(optional)</small><input id="pf-image" type="url"></label>
      <label>Street address<input id="pf-street"></label>
      <label>City<input id="pf-city"></label>
      <label>State<input id="pf-region"></label>
      <label>ZIP<input id="pf-postal"></label>
      <label>Country<input id="pf-country" placeholder="US"></label>
      <label>Price range <small>(optional, e.g. $$)</small><input id="pf-price"></label>
    </div>
    <label>Opening hours <small>(one per line, e.g. Mo-Fr 08:00-17:00)</small><textarea id="pf-hours" rows="2"></textarea></label>
    <label>Service areas <small>(cities, comma or line separated)</small><textarea id="pf-areas" rows="2"></textarea></label>
    <label>Social and review profiles <small>(one URL per line)</small><textarea id="pf-sameas" rows="2"></textarea></label>
    <label>Short description <small>(optional)</small><textarea id="pf-description" rows="2"></textarea></label>
    <h3>Page rules</h3>
    <p>Which schema each kind of page gets. Every page also gets the business, the website and a page entry.</p>
    <div class="pages-table rules-table"><table><thead><tr id="rules-head"></tr></thead><tbody id="rules-body"></tbody></table></div>
    <div class="dialog-actions"><button type="button" class="btn btn-secondary" id="cancel-profile">Cancel</button><button type="submit" class="btn btn-primary">Save profile</button></div>
  </form>
</dialog>

<dialog id="plan-dialog" class="site-dialog">
  <form id="plan-form" method="dialog" class="dialog-body">
    <h2>Schema types for this page</h2>
    <p id="plan-url" class="muted"></p>
    <div id="plan-type-options" class="type-options"></div>
    <label>Other schema.org types <small>(comma-separated)</small><input id="plan-custom"></label>
    <div class="dialog-actions"><button type="button" class="btn btn-secondary" id="plan-auto">Let AI choose</button><button type="button" class="btn btn-secondary" id="plan-cancel">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
  </form>
</dialog>

<dialog id="ai-settings-dialog" class="site-dialog">
  <form id="ai-settings-form" class="dialog-body">
    <h2>AI Settings</h2>
    <p>Shared across your workspace sites. Keys are encrypted on the server, never returned to the browser, and take effect without a restart. Anyone with dashboard access can use these keys for generation.</p>
    <p id="ai-settings-message" role="status"></p>
    <label>Default provider<select id="settings-provider"><option value="openai">OpenAI</option><option value="gemini">Gemini</option></select></label>
    <% for (const provider of ['openai', 'gemini']) { %>
      <fieldset><legend><%= provider === 'openai' ? 'OpenAI' : 'Google Gemini' %></legend>
        <p id="settings-<%= provider %>-status"></p>
        <label>New API key<input id="settings-<%= provider %>-key" type="password" autocomplete="new-password" placeholder="Leave blank to keep saved key"></label>
        <label>Default model<select id="settings-<%= provider %>-model-choice"><option value="">Loading…</option></select></label>
        <label id="settings-<%= provider %>-model-custom" hidden>Custom model ID<input id="settings-<%= provider %>-model" placeholder="Exact model ID for this provider"></label>
        <label class="toggle-row"><input id="settings-<%= provider %>-remove" type="checkbox">Remove saved key (environment key, if set, remains available)</label>
      </fieldset>
    <% } %>
    <div class="dialog-actions"><button id="close-ai-settings" type="button" class="btn btn-secondary">Cancel</button><button id="save-ai-settings" type="submit" class="btn btn-primary">Save settings</button></div>
  </form>
</dialog>

    </div>
  </main>
</div>
<script src="/js/modelPicker.js"></script>
<script src="/js/workspace.js"></script>
</body>
</html>
